### Example environment variables for `docker-compose-metabase.yml`
# Copy this file to `.env` and edit values before running `docker compose up`

# Metabase DB settings
MB_DB_TYPE=postgres
MB_DB_DBNAME=metabase_appdb
MB_DB_PORT=5432
MB_DB_USER=metabase_user
MB_DB_PASS=strongpassword

# (Optional) override the Postgres hostname — default in compose is `db`
#MB_DB_HOST=db
# =============================================================================
# MUSIC PIPELINE PROJECT - ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this file to .env and update with your actual values
# Command: cp .env.example .env
# Load variables: export $(cat .env | xargs)

# =============================================================================
# API CONFIGURATION
# =============================================================================
# External API settings for data collection
API_KEY=your_api_key_here
API_URL=https://jsonplaceholder.typicode.com/users
MAX_RECORDS=100
BATCH_SIZE=10
MAX_RETRIES=3

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# =============================================================================
# POSTGRESQL DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection settings
POSTGRES_HOST=your_postgres_host_here
POSTGRES_PORT=your_postgres_port_here
POSTGRES_DB=your_postgres_db_name_here
POSTGRES_USER=your_postgres_username_here
POSTGRES_PASSWORD=your_postgres_password_here

# PostgreSQL connection URL (alternative format)
# DATABASE_URL=postgresql://staging_user:your_postgres_password_here@localhost:5432/staging_db

# =============================================================================
# SNOWFLAKE CONFIGURATION (OPTIONAL)
# =============================================================================
# Snowflake account details
SNOWFLAKE_ACCOUNT=your_account_identifier.region.snowflakecomputing.com
SNOWFLAKE_USER=your_username
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_DATABASE=your_database
SNOWFLAKE_SCHEMA=your_schema
SNOWFLAKE_ROLE=your_role

# Authentication Method 1: Username/Password
SNOWFLAKE_PASSWORD=your_password_here

# Authentication Method 2: Private Key (Recommended for production)
# SNOWFLAKE_PRIVATE_KEY_PATH=path/to/your/private_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=your_private_key_passphrase

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# Docker network name
DOCKER_NETWORK=fa-dae2-capstone_kafka_network

# =============================================================================
# KAFKA CONFIGURATION (IF USING STREAMING)
# =============================================================================
# Kafka broker settings
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_TOPIC_MUSIC_EVENTS=music_events
# KAFKA_CONSUMER_GROUP=music_pipeline_consumer




# =============================================================================
# BACKUP & RECOVERY
# =============================================================================
# Backup configuration
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=30
# BACKUP_STORAGE_PATH=./backups

# =============================================================================
# NOTES
# =============================================================================
# 1. Never commit this file with actual secrets to version control
# 2. Add .env to your .gitignore file
# 3. For production, use environment-specific configuration management
# 4. Consider using tools like HashiCorp Vault for secret management
# 5. Rotate secrets regularly
# 6. Use strong, unique passwords and keys
# 7. For Snowflake private key auth, ensure proper file permissions (600)